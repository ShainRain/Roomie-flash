<view class="page">

  <view class="head rise">
    <view class="head-main">
      <text class="head-title">明信片</text>
      <text class="en-serif head-en">Postcard · Night Mail</text>
    </view>
    <view class="pill pill-dark room-pill">ROOM ID · {{user.roomId}}</view>
  </view>

  <view class="stage">
    <view class="pc-wrap tilt rise-d1">
      <canvas type="2d" id="postcard" class="postcard"></canvas>
    </view>
  </view>

  <view class="btn-row rise rise-d2">
    <view class="btn-ghost pc-btn" hover-class="btn-hover" bindtap="onSave">{{saving ? '保存中…' : '保存到相册'}}</view>
    <view class="btn-primary pc-btn" hover-class="btn-hover" bindtap="onShare">分享</view>
  </view>

</view>
