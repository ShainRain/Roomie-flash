.page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% 24%, rgba(245, 184, 61, 0.07) 0%, rgba(245, 184, 61, 0) 52%),
    linear-gradient(180deg, var(--night-950) 0%, var(--night-900) 55%, var(--night-950) 100%);
  padding: 40rpx 40rpx 96rpx;
}

/* ---- 编辑式刊头 ---- */
.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 44rpx;
}

.head-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.head-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--night-text);
  letter-spacing: 2rpx;
}

.head-en {
  font-size: var(--fs-micro);
  color: var(--night-sub);
}

.room-pill {
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

/* ---- 明信片舞台:整张微倾斜,装饰随卡片一起转 ---- */
.stage {
  display: flex;
  justify-content: center;
}

.pc-wrap {
  position: relative;
  width: 100%;
  transform: rotate(-3deg);
}

.postcard {
  display: block;
  width: 100%;
  height: 880rpx;
  border-radius: var(--r-card);
  box-shadow: 0 24rpx 64rpx rgba(4, 8, 18, 0.55);
}

/* 胶带 / 邮票 / 邮戳已绘制进 Canvas(保存图片含印刷细节),页面侧不再叠加 */

/* ---- 底部行动 ---- */
.btn-row {
  display: flex;
  gap: 24rpx;
  margin-top: 56rpx;
}

.pc-btn {
  flex: 1;
  padding: 26rpx 0;
  font-size: var(--fs-body);
}

/* ---- 入场:rise-in 错峰 ---- */
@keyframes rise-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes rise-in-tilt {
  from { opacity: 0; transform: translateY(16rpx) rotate(-3deg); }
  to { opacity: 1; transform: translateY(0) rotate(-3deg); }
}

.rise {
  animation: rise-in 0.24s ease-out both;
}

.tilt {
  animation: rise-in-tilt 0.24s ease-out both;
}

.rise-d1 {
  animation-delay: 0.06s;
}

.rise-d2 {
  animation-delay: 0.12s;
}
