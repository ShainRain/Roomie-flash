.page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% 24%, rgba(245, 184, 61, 0.07) 0%, rgba(245, 184, 61, 0) 52%),
    linear-gradient(180deg, var(--night-950) 0%, var(--night-900) 55%, var(--night-950) 100%);
  padding: 40rpx 40rpx 96rpx;
}

/* ---- 编辑式刊头 ---- */
.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 44rpx;
}

.head-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.head-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--night-text);
  letter-spacing: 2rpx;
}

.head-en {
  font-size: var(--fs-micro);
  color: var(--night-sub);
}

.room-pill {
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

/* ---- 明信片舞台:整张微倾斜,装饰随卡片一起转 ---- */
.stage {
  display: flex;
  justify-content: center;
}

.pc-wrap {
  position: relative;
  width: 100%;
  transform: rotate(-3deg);
}

.postcard {
  display: block;
  width: 100%;
  height: 880rpx;
  border-radius: var(--r-card);
  box-shadow: 0 24rpx 64rpx rgba(4, 8, 18, 0.55);
}

/* 胶带小角:照片左上 / 右下对角 */
.tape {
  position: absolute;
  width: 132rpx;
  height: 38rpx;
  border-radius: 6rpx;
  background: rgba(245, 184, 61, 0.30);
  box-shadow: 0 2rpx 6rpx rgba(20, 30, 40, 0.12);
}

.tape-l {
  top: 12rpx;
  left: 20rpx;
  transform: rotate(-42deg);
}

.tape-r {
  top: 492rpx;
  right: 20rpx;
  transform: rotate(-42deg);
}

/* 邮票框:虚线小方块 + 内嵌黑胶小圆 */
.stamp {
  position: absolute;
  top: 56rpx;
  right: 56rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 10rpx;
  border: 3rpx dashed rgba(247, 243, 234, 0.85);
  background: rgba(11, 19, 32, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stamp-vinyl {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--ink-900);
  box-shadow: inset 0 0 0 8rpx rgba(247, 243, 234, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stamp-hole {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--paper-100);
}

/* 邮戳:同心双环 + 深夜时刻,半透明油墨压在照片角上 */
.postmark {
  position: absolute;
  top: 76rpx;
  right: 150rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(138, 143, 152, 0.75);
  transform: rotate(10deg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.postmark-in {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(138, 143, 152, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.postmark-time {
  font-size: var(--fs-micro);
  letter-spacing: 1rpx;
  color: rgba(138, 143, 152, 0.85);
}

/* ---- 底部行动 ---- */
.btn-row {
  display: flex;
  gap: 24rpx;
  margin-top: 56rpx;
}

.pc-btn {
  flex: 1;
  padding: 26rpx 0;
  font-size: var(--fs-body);
}

/* ---- 入场:rise-in 错峰 ---- */
@keyframes rise-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes rise-in-tilt {
  from { opacity: 0; transform: translateY(16rpx) rotate(-3deg); }
  to { opacity: 1; transform: translateY(0) rotate(-3deg); }
}

.rise {
  animation: rise-in 0.24s ease-out both;
}

.tilt {
  animation: rise-in-tilt 0.24s ease-out both;
}

.rise-d1 {
  animation-delay: 0.06s;
}

.rise-d2 {
  animation-delay: 0.12s;
}
