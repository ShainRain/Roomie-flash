<view class="page">

  <!-- 自绘顶栏 -->
  <view class="topbar rise-in" style="padding-top: {{statusBarH}}px;">
    <view class="nav-ic" hover-class="btn-hover" bindtap="onBack">‹</view>
    <view class="nav-ic nav-ic-ghost"></view>
  </view>

  <!-- 刊头:中文大标题 + en-serif 英文小标 + 同频状态 -->
  <view class="title-row rise-in rise-1">
    <view class="title-left">
      <text class="page-title">双人同频</text>
      <text class="page-title-en en-serif">Duo</text>
    </view>
    <view class="pill pill-live pill-breathe">◉ 同频中 · {{sync}}%</view>
  </view>

  <!-- 双人房间:Room Master Scene(与 room 页同一组件/几何/灯光/家具),两个人在同一个房间里 -->
  <view class="stage-wrap rise-in rise-2">
    <room-scene
      floor="{{floor}}"
      light-temp="{{lightTemp}}"
      furniture="{{furnitureKeys}}"
      records="{{recordIds}}"
      characters="{{characters}}"
      lamp-on="{{lampOn}}"
      projector-on="{{projectorOn}}"
      mode="interactive"
      now-playing="{{nowPlaying}}"
      bubbles="{{bubbles}}"
      bind:stagetap="onSceneTap"
      bind:furnituretap="onFurnitureTap"
      bind:chartap="onCharTap"
    />
  </view>

  <!-- 米白纸张共享播放卡:一起听状态 + 波形 + 进度/传输(mini-player) -->
  <view class="card play-card rise-in rise-3">
    <view class="play-head">
      <view class="play-head-info">
        <text class="duo-names">与 {{peer}} 一起听</text>
        <text class="duo-sync">同频中 · {{sync}}%</text>
      </view>
      <view class="sync-wave">
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
      </view>
    </view>
    <mini-player subtitle="{{'歌单由 ' + me.name + ' 控制'}}" tap-target="none" bind:control="onPlayerControl" />
  </view>

  <!-- 退出双人房 -->
  <view class="btn-ghost-danger exit-btn rise-in rise-4" hover-class="btn-hover" bindtap="onExit">退出双人房</view>

</view>
