<view class="page">
  <!-- Room Master Scene：正方形画框，层叠光照 + 家具 + 角色由 room-scene 组件渲染 -->
  <view class="stage-wrap">
    <room-scene
      id="roomScene"
      floor="{{floor}}"
      light-temp="{{lightTemp}}"
      light-bright="{{lightBright}}"
      furniture="{{furnitureKeys}}"
      records="{{recordIds}}"
      lamp-on="{{roomState.lampOn}}"
      projector-on="{{roomState.projectorOn}}"
      characters="{{characters}}"
      mode="interactive"
      now-playing="{{nowPlaying}}"
      bubbles="{{bubbles}}"
      near-id="{{nearId}}"
      active-ids="{{activeIds}}"
      hint="{{showHint}}"
      bind:stagetap="onSceneTap"
      bind:furnituretap="onFurnitureTap"
      bind:chartap="onCharTap"
    />
  </view>
  <view wx:if="{{showHint}}" class="room-hint">点击房间任意位置移动 · 点击物件进行互动</view>

  <!-- 顶部栏 -->
  <view class="topbar" style="padding-top: {{statusBarH}}px;">
    <view class="nav-ic" bindtap="onBack">‹</view>
    <view class="pill pill-live">{{syncOnline ? '● 正在播放 · LIVE 已连线' : '● 正在播放 · LIVE'}}</view>
    <view class="nav-ic" bindtap="onShare">↗</view>
  </view>

  <!-- 底部悬浮播放器 -->
  <view class="dock">
    <mini-player />
  </view>
</view>
