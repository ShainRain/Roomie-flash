.page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--night-950) 0%, var(--night-900) 55%, var(--night-950) 100%);
  overflow: hidden;
}

/* 正方形舞台：与 Master Scene 底图 1:1，不切边 */
.stage-wrap {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 100vw;
  height: 100vw;
  transform: translate(-50%, -50%);
}

.room-hint { position: absolute; z-index: 1200; top: 150rpx; left: 32rpx; right: 32rpx; text-align: center; color: rgba(247, 243, 234, 0.78); font-size: 22rpx; }

/* ---- 顶部栏 ---- */
.topbar {
  position: relative;
  z-index: 1300;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 0;
}

.nav-ic {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(16, 27, 42, 0.72);
  border: 1rpx solid var(--night-line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--night-text);
  box-shadow: 0 8rpx 24rpx rgba(11, 19, 32, 0.45);
}

.topbar .pill-live {
  padding-left: 18rpx;
  padding-right: 18rpx;
  box-shadow: 0 5rpx 14rpx rgba(43, 201, 107, 0.20);
}

/* ---- 底部悬浮播放器（mini-player 组件） ---- */
.dock {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 1300;
}
