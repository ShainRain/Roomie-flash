<view class="page">
  <roomie-header custom-nav subtitle="{{user.roomName}} · {{user.roomId}}" avatar="{{user.name[0]}}" />
  <view class="page-pad">

    <!-- 编辑式刊头 -->
    <view class="masthead anim-in">
      <view class="masthead-text">
        <text class="masthead-title">我的放映室</text>
        <text class="en-serif masthead-en">My Room</text>
      </view>
      <view class="masthead-gear" hover-class="btn-hover" bindtap="onSetting">⚙</view>
    </view>

    <!-- Personal Room Hero:我的房间(Master 派生 vignette),身份浮层而非大头像 -->
    <view class="hero anim-in anim-d1" bindtap="onGotoRoom" hover-class="btn-hover">
      <image class="hero-img" src="/assets/img/vignette-momo.webp" mode="aspectFill" />
      <view class="hero-id">
        <text class="hero-name">{{user.name}}</text>
        <text class="pill pill-dark">Lv.{{user.level}}</text>
        <text class="pill pill-amber">{{user.badge}}</text>
      </view>
      <view class="hero-room pill pill-dark">{{user.roomName}} · {{user.roomId}}</view>
    </view>

    <!-- 次级入口:形象定制(头像/服装双槽位导入) -->
    <view class="dress-row anim-in anim-d1">
      <view class="btn-ghost me-btn" hover-class="btn-hover" data-name="换发型" bindtap="onDress">换发型</view>
      <view class="btn-ghost me-btn" hover-class="btn-hover" bindtap="onImportOutfit">换服装</view>
      <view class="btn-ghost me-btn" hover-class="btn-hover" bindtap="onImportAvatar">换头像</view>
      <image wx:if="{{avatarSrc}}" class="dress-avatar" src="{{avatarSrc}}" mode="aspectFit" bindtap="onImportAvatar" />
    </view>
    <view class="dress-meta anim-in anim-d1">
      <text class="dress-hint">{{avatarHint}}</text>
      <view class="dress-links">
        <text class="me-link" bindtap="onImportImageFile">相册里选不到？从聊天记录导入</text>
        <text wx:if="{{hasCustom}}" class="me-link me-link-reset" bindtap="onResetAvatar">恢复默认形象</text>
      </view>
    </view>

    <!-- 一整张米白纸张档案卡 -->
    <view class="card sheet anim-in anim-d2">

      <!-- 我的唱片墙(方形收藏封面,选中绿勾) -->
      <view class="sec-head">
        <text class="paper-title">我的唱片墙</text>
        <text class="wall-count">已选 {{selected.length}} / {{maxPick}}</text>
      </view>
      <text class="wall-desc">从收藏的 {{records.length}} 张唱片中挑选,挂在房间的墙上</text>
      <view wx:if="{{selected.length === 0}}" class="wall-tip">还没有选唱片 —— 点下面的唱片,把喜欢的声音挂上墙</view>
      <view class="wall-grid">
        <view
          wx:for="{{cells}}"
          wx:key="id"
          class="rec {{item.on ? 'rec-on' : ''}}"
          hover-class="btn-hover"
          data-id="{{item.id}}"
          bindtap="onToggleRecord"
        >
          <image class="rec-cover" src="{{item.cover}}" mode="aspectFit" />
          <text class="rec-title">{{item.title}}</text>
          <view wx:if="{{item.on}}" class="rec-check">✓</view>
        </view>
        <view class="rec rec-add">
          <text class="rec-add-plus">+</text>
        </view>
      </view>
      <view class="btn-primary save-wall {{dirty ? '' : 'save-done'}}" hover-class="btn-hover" bindtap="onSave">
        {{dirty ? '保存布置' : '已保存'}}
      </view>

      <view class="sheet-line"></view>

      <!-- 我的成就 -->
      <view class="sec-head">
        <text class="paper-title">我的成就</text>
      </view>
      <view class="ach-row">
        <view class="ach" wx:for="{{achievements}}" wx:key="name">
          <view class="ach-ic" style="background: {{item.color}};">{{item.glyph}}</view>
          <text class="ach-name">{{item.name}}</text>
          <text class="ach-lv">Lv.{{item.lv}}</text>
        </view>
      </view>

      <view class="sheet-line"></view>

      <!-- 房间档案(状态,而非第二张缩略图) -->
      <view class="sec-head">
        <text class="paper-title">房间档案</text>
      </view>
      <view class="room-row" hover-class="btn-hover" bindtap="onGotoRoom">
        <view class="room-meta">
          <text class="room-now">当前使用 · {{user.roomName}}</text>
          <text class="room-sub">{{roomInfo.floorName}}地板 · {{roomInfo.lightTemp}}K 暖光 · {{roomInfo.furnitureCount}} 件家具</text>
        </view>
        <text class="room-arrow">›</text>
      </view>

    </view>
  </view>
</view>
