<view class="page">
  <roomie-header custom-nav subtitle="深夜放映室 · 0731" avatar="M" pageTitle="好友" pageSubtitle="FRIENDS" />
  <view class="page-pad">

    <!-- 刊头副行 -->
    <view class="head anim-in">
      <text class="head-sub">夜里，每个朋友都住在自己的小房间里。</text>
    </view>

    <!-- 好友房间 vignette 横排:Master 派生的小房间(同色彩/材质/灯光/视角/角色语言) -->
    <scroll-view class="v-row anim-in anim-d1" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{vignettes}}"
        wx:key="name"
        class="v-card"
        data-type="{{item.type}}"
        data-name="{{item.name}}"
        bindtap="onFriendAction"
        hover-class="btn-hover"
      >
        <image class="v-img" src="{{item.img}}" mode="aspectFill" />
        <view class="v-meta">
          <view class="v-name-row">
            <view class="v-dot"></view>
            <text class="v-name">{{item.name}}</text>
            <view class="v-act {{inviting === item.name ? 'v-act-wait' : ''}}">{{inviting === item.name ? '等待中…' : item.action}}</view>
          </view>
          <text class="v-status">{{item.status}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 在线好友 -->
    <view class="card friend-card online-card anim-in anim-d2">
      <view class="card-head">
        <text class="paper-title">在线好友 · {{online.length}}</text>
        <text class="card-head-en en-serif">Online</text>
      </view>
      <view class="friend" wx:for="{{online}}" wx:key="name">
        <view class="f-avatar" style="background: {{item.color}};">
          {{item.name[0]}}
          <view class="f-dot"></view>
        </view>
        <view class="f-info">
          <view class="f-name-row">
            <text class="f-name">{{item.name}}</text>
            <text wx:if="{{item.tag}}" class="f-tag">{{item.tag}}</text>
          </view>
          <text class="f-status">在线 · {{item.status}}</text>
        </view>
        <view
          class="f-btn f-btn-solid {{inviting === item.name ? 'f-btn-wait' : ''}}"
          hover-class="btn-hover"
          data-type="{{item.type}}"
          data-name="{{item.name}}"
          bindtap="onFriendAction"
        >{{inviting === item.name ? '等待中…' : item.action}}</view>
      </view>
    </view>

    <!-- 离线好友:区块整体降透明度 -->
    <view class="card friend-card offline-card anim-in anim-d3">
      <view class="card-head">
        <text class="paper-title">离线好友 · {{offline.length}}</text>
        <text class="card-head-en en-serif">Offline</text>
      </view>
      <view class="friend" wx:for="{{offline}}" wx:key="name">
        <view class="f-avatar" style="background: {{item.color}};">{{item.name[0]}}</view>
        <view class="f-info">
          <view class="f-name-row">
            <text class="f-name">{{item.name}}</text>
          </view>
          <text class="f-status">{{item.status}}</text>
        </view>
        <view
          class="f-btn f-btn-ghost {{inviting === item.name ? 'f-btn-wait' : ''}}"
          hover-class="btn-hover"
          data-type="{{item.type}}"
          data-name="{{item.name}}"
          bindtap="onFriendAction"
        >{{inviting === item.name ? '等待中…' : item.action}}</view>
      </view>
    </view>

    <!-- 邀请好友(页面主 CTA) -->
    <view class="btn-primary invite-cta anim-in anim-d4" hover-class="btn-hover" bindtap="onBannerInvite">
      <text class="invite-cta-label">邀请好友进房间</text>
      <text class="invite-cta-arrow">→</text>
    </view>

  </view>
</view>
