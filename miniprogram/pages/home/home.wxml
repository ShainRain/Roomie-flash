<view class="page">
  <roomie-header custom-nav subtitle="{{user.roomName}} · {{user.roomId}}" avatar="{{user.name[0]}}" share bind:share="onShare" />
  <view class="page-pad">

    <!-- 今晚状态(克制,不抢房间) -->
    <view class="tonight anim-in">
      <text class="tonight-hi">今晚,</text>
      <text class="tonight-title"><text class="tonight-name">{{user.name}}</text> 想放一首歌</text>
    </view>

    <!-- Room Master Hero:房间是第一视觉主体,UI 悬浮于房间之上 -->
    <view class="hero-wrap anim-in anim-d1">
      <view class="hero-stage">
        <room-scene
          floor="{{floor}}"
          light-temp="{{lightTemp}}"
          light-bright="{{lightBright}}"
          furniture="{{furnitureKeys}}"
          records="{{recordIds}}"
          characters="{{characters}}"
          lamp-on="{{true}}"
          projector-on="{{true}}"
          mode="preview"
          now-playing="{{nowPlaying}}"
          bind:stagetap="onEnterRoom"
        />
      </view>
      <view class="hero-pill hero-pill-tl pill pill-dark" bindtap="onEnterRoom"><view class="live-dot"></view>放映中 · 2 位 roomie</view>
      <view class="hero-pill hero-pill-tr pill pill-live">+12 氛围值</view>
      <view class="hero-chip" bindtap="onEnterRoom">
        <view class="chip-avatar">M</view>
        <text class="chip-text">{{user.name}} 走近唱机</text>
      </view>
    </view>

    <!-- 放映任务 -->
    <view class="card task-card anim-in anim-d2" bindtap="onEnterRoom">
      <view class="task-plus">+</view>
      <view class="task-text">
        <text class="task-sub">今晚的放映任务</text>
        <text class="task-title">让 KIKI 找到唱片墙</text>
      </view>
      <view class="pill pill-amber">+80 XP</view>
    </view>

    <!-- 内嵌播放器 -->
    <mini-player class="player-wrap anim-in anim-d3" />

    <!-- 进入放映室 -->
    <view class="btn-primary cta anim-in anim-d4" hover-class="btn-hover" bindtap="onEnterRoom">
      <text class="cta-label">进入放映室</text>
      <text class="cta-arrow">→</text>
    </view>

  </view>
</view>
